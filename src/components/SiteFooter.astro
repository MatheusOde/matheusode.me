---
import { site } from '../config/site';
---
<footer class="site-footer">
  <p>© {new Date().getFullYear()} {site.name}</p>
  <nav aria-label="Social links">
    <a href={`mailto:${site.email}`} data-event="email_contact_clicked">Email</a>
    <a href={site.linkedin} data-event="linkedin_clicked">LinkedIn <span aria-hidden="true">↗</span></a>
    <a href={site.github}>GitHub <span aria-hidden="true">↗</span></a>
    {site.resume && <a href={site.resume} download="matheus-odebrecht-resume.pdf" data-event="resume_downloaded">Résumé</a>}
  </nav>
</footer>
<style>
  .site-footer { max-width: var(--content-width); margin: 0 auto; padding: 2rem clamp(1.5rem, 4vw, 4.5rem); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; color: var(--text-secondary); font-size: .75rem; }
  p { margin: 0; }
  nav { display: flex; flex-wrap: wrap; gap: 1.2rem; }
  a { display: inline-block; padding: .5rem 0; text-decoration: none; }
  @media (max-width: 767px) { .site-footer { padding: 2rem 1.25rem; } }
</style>
