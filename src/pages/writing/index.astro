---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isPublishedWriting, sortByPublishedDate } from '../../lib/content';
const entries=sortByPublishedDate(await getCollection('writing', ({data}) => isPublishedWriting(data)));
---
<BaseLayout title="Writing" description="Notes on systems integration, engineering trade-offs, and the relationship between software and operations.">
  <header class="page-header"><p class="eyebrow">Writing / Ideas in practice</p><h1>Good questions.<br />Better systems.</h1><p class="lead">Systems integration, engineering trade-offs, and the relationship between software and operations.</p></header>
  {entries.length > 0 ? <section class="section">{entries.map(entry=><article class="card"><p class="eyebrow">{entry.data.tags.join(' · ')}</p><h2><a href={`/writing/${entry.id}/`} data-event="article_opened">{entry.data.title}</a></h2><p>{entry.data.summary}</p><time datetime={entry.data.publishedDate!.toISOString()}>{entry.data.publishedDate!.toLocaleDateString('en',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'})}</time></article>)}<a href="/rss.xml">Subscribe via RSS</a></section> : <section class="section prose"><h2>A space for considered ideas.</h2><p>There are no published articles here yet.</p><p>Have a question about an integration or an engineering decision? <a href="/contact/">I would be glad to hear it.</a></p></section>}
</BaseLayout>
